# Spring profile
SPRING_PROFILES_ACTIVE=local

# Database
DB_URL=localhost
DB_PORT=5432
DB_NAME=bazaar
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT
JWT_PRIVATE_KEY_PATH=./keys/local/private_key.pem
JWT_PUBLIC_KEY_PATH=./keys/local/public_key.pem
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_FROM=noreply@example.com
MAIL_SENDER_NAME=Bazaar Platform
APP_VERIFICATION_BASE_URL=http://localhost:8080

# AI / RAG
GROG_API=replace_me
OLLAMA_BASE_URL=http://localhost:11434
RAG_PROJECT_ROOT=.

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_PHONE=0000000000

# M-Pesa
MPESA_CONSUMER_KEY=replace_me
MPESA_CONSUMER_SECRET=replace_me
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace_me
MPESA_CALLBACK_URL=https://your-domain.example.com/api/v1/payments/webhook/mpesa
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# File storage
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_MB=5
FILE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp